# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Dependencies
node_modules
.pnp
.pnp.*

# Build output
dist
dist-ssr
*.local

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment
.env
.env.*
!.env.example

# Client source material (raw brief + extracted text) - not site assets.
# These are the supplied documents and brand artwork; the derived site assets
# live in public/ and src/data/.
documents/
logoandcontent/
.docx-text/

# Runtime data. The SQLite store holds the live content edits, the media rows and
# the admin password hash; it is created locally with "npm run seed" and re-seeded
# from api/seed.json, so it is not versioned.
api/data/*.sqlite
api/data/*.sqlite-journal
api/data/*.sqlite-wal
api/data/*.sqlite-shm

